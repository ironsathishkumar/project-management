NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/project_tracker
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads

# Integrations — public URL GitHub webhooks can reach, key for encrypting stored tokens
API_PUBLIC_URL=http://localhost:4000
ENCRYPTION_KEY=change-me
GITHUB_POLL_MINUTES=5

# Optional SMTP — when empty, emails are logged to the API console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Project Tracker <noreply@yourdomain.com>
